---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Home"
  description="A progressive portfolio and learning log from a student developer."
>
  <section class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
    <div>
      <p class="eyebrow" data-aos="fade-up">student developer · always learning</p>
      <h1
        class="mt-6 max-w-3xl text-5xl font-semibold tracking-tight text-zinc-100 sm:text-7xl"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Building things to understand how they work.
      </h1>
      <p class="prose-note mt-7" data-aos="fade-up" data-aos-delay="160">
        I’m a student developer learning by making. This is where I share the
        assignments, experiments, and small discoveries that mark the path.
      </p>
      <div class="mt-9 flex flex-wrap gap-4" data-aos="fade-up" data-aos-delay="220">
        <a
          href={`${base}projects`}
          class="inline-flex items-center rounded-md bg-emerald-400 px-5 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-emerald-300"
        >
          See what I’m building
        </a>
        <a
          href={`${base}journey`}
          class="inline-flex items-center rounded-md border border-zinc-700 px-5 py-3 text-sm font-medium text-zinc-200 transition-colors hover:border-indigo-400 hover:text-indigo-300"
        >
          Read the learning log
        </a>
      </div>
    </div>

    <aside
      class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950 shadow-2xl shadow-zinc-950/40"
      data-aos="fade-left"
    >
      <div class="flex items-center gap-2 border-b border-zinc-800 bg-zinc-900/80 px-4 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" aria-hidden="true"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-indigo-400" aria-hidden="true"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
        <span class="ml-2 font-mono text-[10px] text-zinc-600">focus.sh</span>
      </div>
      <div class="p-6 sm:p-7">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-emerald-400">
          ~/student-dev/current-focus
        </p>
        <h2 class="mt-5 text-2xl font-semibold text-zinc-100">
          From “it works” to “I understand why.”
        </h2>
        <p class="mt-4 leading-7 text-zinc-400">
          Right now I’m practicing accessible interfaces, predictable data
          flows, and writing about the bugs that teach me the most.
        </p>
        <div class="mt-7 border-t border-zinc-800 pt-5">
          <p class="font-mono text-xs leading-7 text-zinc-500">
            <span class="text-indigo-400">$</span> focus --on learning<br />
            <span class="text-indigo-400">→</span> make a small thing<br />
            <span class="text-indigo-400">→</span> notice what breaks<br />
            <span class="text-emerald-400">✓</span> write down the lesson
          </p>
        </div>
      </div>
    </aside>
  </section>

  <section class="mt-24 border-t border-zinc-800 pt-8">
    <div
      class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between"
      data-aos="fade-up"
    >
      <div>
        <p class="eyebrow">how to use this site</p>
        <h2 class="mt-3 text-2xl font-semibold text-zinc-100">
          A portfolio that shows the process.
        </h2>
      </div>
      <p class="max-w-md text-sm leading-7 text-zinc-500">
        Projects show the outcome. Journey notes show the decisions, failed
        attempts, and useful fixes behind them.
      </p>
    </div>
  </section>
</BaseLayout>